# Core
APP_NAME=Nischen-Explorer
CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=15
MAX_WORKERS=8

# News
GNEWS_API_KEY=
GOOGLE_BOOKS_API_KEY=
THENEWS_API_KEY=

# Reddit
REDDIT_CLIENT_ID=
REDDIT_SECRET=
REDDIT_USER_AGENT=nischen-explorer/1.0 by your-reddit-user

# X API v2
X_BEARER_TOKEN=

# DataForSEO
DATAFORSEO_USERNAME=
DATAFORSEO_PASSWORD=
DATAFORSEO_LOCATION_CODE=2276
DATAFORSEO_LANGUAGE_CODE=de

# Keepa: Amazon Germany domain = 3
KEEPA_API_KEY=
KEEPA_DOMAIN=3
KEEPA_MAX_RESULTS=20


# YouTube
YOUTUBE_API_KEY=
YOUTUBE_ORDER=relevance

# Meta / Instagram / Facebook Pages
META_GRAPH_VERSION=v25.0
META_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_USER_ID=
FACEBOOK_PAGE_IDS=

# Pinterest Trends API (availability is limited to eligible accounts/partners)
PINTEREST_ACCESS_TOKEN=
PINTEREST_REGION=DE

# DataForSEO commerce / services
DATAFORSEO_SHOPPING_LOCATION_CODE=2276
DATAFORSEO_SHOPPING_LANGUAGE_CODE=de
# Exact city/location code for Local Finder; leave empty to disable
DATAFORSEO_SERVICE_LOCATION_CODE=
DATAFORSEO_MERCHANT_MAX_POLLS=6
DATAFORSEO_MERCHANT_POLL_SECONDS=1.5

# Generic public feeds / URL requests / crawler
# Comma-separated URLs; {keyword} is expanded and URL-encoded.
FEED_URLS=
URL_REQUESTS=
CRAWL_URLS=
CRAWL_MAX_PAGES=20
CRAWL_MAX_DEPTH=1
CRAWL_USER_AGENT=Nischen-Explorer/4.0 (+respectful crawler)

# Optional external social connectors. These are disabled unless an endpoint is explicitly configured.
OCTOLENS_API_KEY=
OCTOLENS_ENDPOINT=
XPOZ_API_KEY=
XPOZ_ENDPOINT=
SNITCHFEED_API_KEY=
SNITCHFEED_ENDPOINT=

# Persistence. SQLite works out of the box; PostgreSQL is optional.
DATABASE_URL=sqlite:///./nischen_explorer.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=gapdb
# Async HTTP / UI cache
HTTP_CONNECT_TIMEOUT_SECONDS=5
